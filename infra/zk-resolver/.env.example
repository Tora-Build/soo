# zk-resolver secrets. Copy to `.env` (gitignored) or set as real environment
# variables. Never commit a filled-in copy.

# Devnet RPC. A private endpoint is strongly preferred over the public one.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Funded fee payer. `attest_outcome_zk` is PERMISSIONLESS — the attestor's
# signature is the authority — so this key buys transactions and nothing else.
# Either a JSON byte array (what solana-keygen writes) or a base58 secret key.
RESOLVER_KEYPAIR=[12,34,...]

# Primus credentials. These authenticate this service to Primus and sign the
# REQUEST; they do NOT sign the attestation. Every attestation is signed by
# Primus' global attestor 0xDB736B13E2f522dBE18B2015d0291E4b193D8eF6.
PRIMUS_APP_ID=0x21f311dac5909e7a5ff2d9459a30614d0ccbac91
PRIMUS_APP_SECRET=

# Optional, `--review` only. Advisory rule review; never decides an outcome.
GEMINI_API_KEY=

# --serve (the /attest-preview proof endpoint). Every preview spends ONE unit
# of Primus quota, so the endpoint binds loopback by default and refuses to
# bind a routable address without this token.
RESOLVER_API_TOKEN=
# RESOLVER_BIND=127.0.0.1
# RESOLVER_PORT=8787
# RESOLVER_PREVIEW_MIN_INTERVAL_MS=15000
# RESOLVER_PREVIEW_WINDOW_MAX=20
# RESOLVER_PREVIEW_WINDOW_MS=86400000

# Optional tuning.
# RESOLVER_INTERVAL_MS=300000
# PRIMUS_TIMEOUT_MS=120000
# RESOLVER_REGISTRY=./markets.json
# RESOLVER_STATE_PATH=./.state/resolver.json
