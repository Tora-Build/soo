# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real key here.
#
#   cp packages/sooth-data/.env.example packages/sooth-data/.env

# Which cluster to serve. mainnet | devnet | localnet
SOOTH_DATA_CHAIN=devnet

# ── RPC ──────────────────────────────────────────────────────────────────────
#
# An Alchemy key selects the right host for the chain above and enables the
# Account Archive, which answers getAccountInfo at any past slot. Price history
# is served from it; without a key that endpoint reports unavailable rather
# than failing, and everything else falls back to the public RPC.
#
# The public endpoint is heavily rate-limited: this service measured a single
# cold /v12/fills at ~2.7s on api.devnet.solana.com and a 429 on the second
# uncached request. Anything past a demo wants a real key.
ALCHEMY_API_KEY=

# Explicit override. Wins over ALCHEMY_API_KEY, so a local validator or another
# provider needs no code change.
# RPC_URL=http://127.0.0.1:8899

# ── Indexer ──────────────────────────────────────────────────────────────────
#
# Where history is stored. One SQLite file; the directory must exist.
SOOTH_INDEX_DB=./sooth-index.db

# Markets to index, comma-separated market PDAs. The book PDA for each is
# derived, so only the market is needed here.
SOOTH_MARKETS=

# ── Service ──────────────────────────────────────────────────────────────────
PORT=42069
