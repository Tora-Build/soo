      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "outcome",
            "docs": [
              "0 = NO, 1 = YES (matches protocol-wide OUTCOME encoding)."
            ],
            "type": "u8"
          },
          {
            "name": "delta_shares",
            "docs": [
              "Signed share delta in WAD. Positive = buy; negative = sell."
            ],
            "type": "i128"
          },
          {
            "name": "cost_wad",
            "docs": [
              "Signed cost in WAD. Positive = paid; negative = proceeds (sell)."
