  "types": [
    {
      "name": "AmmState",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "docs": [
              "Backlink to the market PDA (parity with EVM addressing)."
            ],
            "type": "pubkey"
          },
          {
            "name": "q_yes",
            "docs": [
              "Outstanding YES shares in WAD. Signed because intermediate `q + Δ` can",
              "dip during multi-leg trades (see architecture §4.2)."
            ],
            "type": "i128"
          },
          {
            "name": "q_no",
            "docs": ["Outstanding NO shares in WAD."],
            "type": "i128"
          },
          {
            "name": "b",
            "docs": ["LMSR liquidity parameter in WAD. > 0 by invariant."],
            "type": "i128"
          },
          {
            "name": "seed_q_yes",
            "docs": [
              "Initial seed liquidity (creator deposit). Used by the dismiss/refund",
              "flow per architecture §9."
            ],
            "type": "i128"
          },
          {
            "name": "seed_q_no",
            "type": "i128"
          },
          {
            "name": "fee_b_base_wad",
            "docs": [
              "Accumulator for the bBase fee leg (50% pre-graduation per §8).",
              "In WAD; CPI'd out to the fee router after graduation."
            ],
            "type": "u128"
          },
          {
            "name": "trial_end_at",
            "type": "i64"
          },
          {
            "name": "is_graduated",
            "type": "bool"
          },
          {
            "name": "is_dismissed",
            "type": "bool"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "InitializeAmmStateArgs",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "initial_b",
            "docs": [
              "Initial LMSR liquidity parameter `b` in WAD. Must be > 0.",
              "Architecture §2.2 / §4.2 — `b` controls the curve's price elasticity;",
              "the SDK's `WAD * 1000` default mirrors the LMSR golden test."
            ],
            "type": "u128"
          },
          {
            "name": "trial_end_at",
            "docs": [
              "`trial_end_at` from architecture §4.2 — usually `market.deadline` so",
              "the trial / graduation accumulator window closes on settle. Stored",
              "alongside `b` to keep this ix arg-driven (the alternative — read it",
              "off `Market` — would re-introduce the cross-program type-coupling",
              "the spec calls out as load-bearing)."
            ],
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "LiquidityProvided",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "lp_amount",
            "type": "u64"
          },
          {
            "name": "ts",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "Market",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market_id",
            "docs": [
              "Deterministic id derived from `keccak256(question || creator || nonce)`,",
              "truncated to 16 bytes per architecture §2.2. Seed for every per-market",
              "PDA in the protocol — see module comment."
            ],
            "type": {
              "array": ["u8", 16]
            }
          },
          {
            "name": "creator",
            "type": "pubkey"
          },
          {
            "name": "adjudicator",
            "docs": [
              "Adjudicator program id. The adjudicator-CPI auth check on `lock` /",
              "`settle` will validate the caller's program against this."
            ],
            "type": "pubkey"
          },
          {
            "name": "question_hash",
            "type": {
              "array": ["u8", 32]
            }
          },
          {
            "name": "yes_mint",
            "type": "pubkey"
          },
          {
            "name": "no_mint",
            "type": "pubkey"
          },
          {
            "name": "vault",
            "docs": [
              "USDC ATA owned by `vault_authority` PDA. All collateral for this market."
            ],
            "type": "pubkey"
          },
          {
            "name": "lock_vault",
            "docs": [
              "USDC ATA owned by `lock_authority` PDA. AMM lock-on-sell escrow."
            ],
            "type": "pubkey"
          },
          {
            "name": "start_time",
            "type": "i64"
          },
          {
            "name": "deadline",
            "type": "i64"
          },
          {
            "name": "lifecycle",
            "type": {
              "defined": {
                "name": "MarketLifecycle"
              }
            }
          },
          {
            "name": "winning_outcome",
            "docs": [
              "Resolved outcome, valid only when `lifecycle == Settled`.",
              "0 = NO, 1 = YES, 2 = INVALID per protocol-wide OUTCOME encoding."
            ],
            "type": "u8"
          },
          {
            "name": "bump",
            "docs": ["Bump for the `Market` PDA itself."],
            "type": "u8"
          },
          {
            "name": "vault_authority_bump",
            "docs": ["Bump for the `vault_authority` signer PDA."],
            "type": "u8"
          },
          {
            "name": "lock_authority_bump",
            "docs": ["Bump for the `lock_authority` signer PDA."],
            "type": "u8"
          },
          {
            "name": "yes_mint_bump",
            "docs": ["Bump for `yes_mint` PDA."],
            "type": "u8"
          },
          {
            "name": "no_mint_bump",
            "docs": ["Bump for `no_mint` PDA."],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "MarketLifecycle",
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Initializing"
          },
          {
            "name": "Open"
          },
          {
            "name": "Locked"
          },
          {
            "name": "Settled"
          }
        ]
      }
    },
    {
      "name": "Position",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "yes_shares",
            "docs": ["Outstanding YES shares the user holds, WAD. Always ≥ 0."],
            "type": "i128"
          },
          {
            "name": "no_shares",
            "docs": ["Outstanding NO shares the user holds, WAD. Always ≥ 0."],
            "type": "i128"
          },
          {
            "name": "lock_nonce",
            "docs": [
              "Per-`Position` monotonic counter incremented on every sell. Used as",
              "part of the `LockEntry` PDA seed so concurrent in-flight sells from",
              "the same user on the same market produce distinct lock accounts."
            ],
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "LockEntry",
      "docs": [
        "Per-sell USDC escrow record. Created on `sell_positions`, drained",
        "and closed by `claim_unlocked` once `unlock_at` passes."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "amount_usdc",
            "docs": [
              "USDC base units (6 decimals on Solana mainnet) escrowed at sell time."
            ],
            "type": "u64"
          },
          {
            "name": "unlock_at",
            "docs": [
              "Unix timestamp at which `claim_unlocked` becomes callable."
            ],
            "type": "i64"
          },
          {
            "name": "nonce",
            "docs": ["Per-`Position` monotonic nonce — part of the seed."],
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "PositionSold",
      "docs": [
        "Emitted on the sell branch after the proceeds have been moved into",
        "the per-sell `LockEntry` PDA."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "outcome",
            "type": "u8"
          },
          {
            "name": "shares_sold",
            "type": "u128"
          },
          {
            "name": "lock_entry",
            "type": "pubkey"
          },
          {
            "name": "amount_usdc",
            "type": "u64"
          },
          {
            "name": "unlock_at",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "LockClaimed",
      "docs": ["Emitted by `claim_unlocked` after a successful payout."],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "lock_entry",
            "type": "pubkey"
          },
          {
            "name": "amount_usdc",
            "type": "u64"
          },
          {
            "name": "ts",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "PositionTraded",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "outcome",
            "docs": [
              "0 = NO, 1 = YES (matches protocol-wide OUTCOME encoding)."
            ],
            "type": "u8"
          },
          {
            "name": "delta_shares",
            "docs": [
              "Signed share delta in WAD. Positive = buy; negative = sell."
            ],
            "type": "i128"
          },
          {
            "name": "cost_wad",
            "docs": [
              "Signed cost in WAD. Positive = paid; negative = proceeds (sell)."
            ],
            "type": "i128"
          },
          {
            "name": "ts",
            "docs": ["Unix timestamp from `Clock`."],
            "type": "i64"
          }
        ]
      }
    }
  ]
}
