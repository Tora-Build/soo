          "docs": [
            "Per-(user, market) Position. Lazily created on first trade per",
            "architecture §4.2 — `init_if_needed` keeps the surface single-ix from",
            "the SDK's perspective."
          ],
          "writable": true,
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [
                  112,
