            "type": "pubkey"
          },
          {
            "name": "start_time",
            "type": "i64"
          },
          {
            "name": "deadline",
            "type": "i64"
          },
          {
            "name": "lifecycle",
            "type": {
              "defined": {
                "name": "MarketLifecycle"
              }
            }
          },
          {
            "name": "winning_outcome",
            "docs": [
              "Resolved outcome, valid only when `lifecycle == Settled`.",
              "0 = NO, 1 = YES, 2 = INVALID per protocol-wide OUTCOME encoding."
            ],
            "type": "u8"
          },
          {
            "name": "bump",
            "docs": [
              "Bump for the `Market` PDA itself."
            ],
            "type": "u8"
          },
          {
            "name": "vault_authority_bump",
            "docs": [
              "Bump for the `vault_authority` signer PDA."
            ],
            "type": "u8"
          },
          {
            "name": "lock_authority_bump",
            "docs": [
              "Bump for the `lock_authority` signer PDA."
            ],
            "type": "u8"
          },
          {
            "name": "yes_mint_bump",
            "docs": [
