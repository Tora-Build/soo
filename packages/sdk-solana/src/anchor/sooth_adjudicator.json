  "errors": [
    {
      "code": 6000,
      "name": "NotAuthority",
      "msg": "Caller is not the registered authority for this adjudicator"
    },
    {
      "code": 6001,
      "name": "UnsupportedKind",
      "msg": "Adjudicator kind does not support this operation (e.g. ZkTLS attestation on a Manual adjudicator)"
    },
    {
      "code": 6002,
      "name": "AlreadyAttested",
      "msg": "Adjudicator has already attested an outcome; re-attestation is not permitted"
    },
    {
      "code": 6003,
      "name": "NotAttested",
      "msg": "Adjudicator has not yet attested an outcome"
    },
    {
      "code": 6004,
      "name": "InvalidOutcome",
      "msg": "Invalid outcome (must be NO=0, YES=1, or INVALID=2)"
    },
    {
      "code": 6005,
      "name": "MarketMismatch",
      "msg": "Adjudicator account does not match the supplied market"
    },
    {
      "code": 6006,
      "name": "AuthorityIsDefault",
      "msg": "Authority pubkey must not be the default (all-zero) key"
    },
    {
      "code": 6007,
      "name": "DisputeNotImplemented",
      "msg": "Dispute path is not implemented in v1; see architecture §4.4"
    },
    {
      "code": 6008,
      "name": "NotDisputeAuthority",
      "msg": "Caller is not the registered dispute authority for this adjudicator"
    },
    {
      "code": 6009,
      "name": "AlreadyDisputed",
      "msg": "Adjudicator has already been disputed; dispute is one-shot per market"
    },
    {
      "code": 6010,
      "name": "MarketAlreadySettled",
      "msg": "Market is already settled; dispute can no longer override the outcome"
    }
  ],
  "types": [
    {
      "name": "Adjudicator",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "docs": [
              "`sooth_market::Market` account this adjudicator resolves."
            ],
            "type": "pubkey"
          },
          {
            "name": "authority",
            "docs": [
              "Authority gating `attest_outcome` for the `Manual` variant."
            ],
            "type": "pubkey"
          },
          {
            "name": "dispute_authority",
            "docs": [
              "Authority gating `dispute` (veto / override path). Defaults to",
              "`authority` at register-time; production rotates to a guardian",
              "multisig. EVM analogue: per-adjudicator guardian whitelist,",
              "collapsed to a single Pubkey for v1."
            ],
            "type": "pubkey"
          },
          {
            "name": "kind",
            "type": {
              "defined": {
                "name": "AdjudicatorKind"
              }
            }
          },
          {
            "name": "attested_outcome",
            "docs": [
              "0=NO, 1=YES, 2=INVALID per protocol-wide OUTCOME encoding.",
              "Populated by `attest_outcome`; overridden by `dispute`."
            ],
            "type": {
              "option": "u8"
            }
          },
          {
            "name": "attested_at",
            "docs": [
              "Unix-seconds timestamp of the original attestation. NOT",
              "overwritten by `dispute` — the dispute timestamp lives on",
              "`disputed_at`."
            ],
            "type": {
              "option": "i64"
            }
          },
          {
            "name": "disputed",
            "docs": [
              "One-shot guard: once `dispute` mutates `attested_outcome`,",
              "this flag is set true and a subsequent dispute is rejected."
            ],
            "type": "bool"
          },
          {
            "name": "disputed_at",
            "docs": [
              "Unix-seconds timestamp of the dispute, populated alongside",
              "`disputed`. `None` if `dispute` has not been called."
            ],
            "type": {
              "option": "i64"
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "AdjudicatorKind",
      "docs": [
        "Adjudicator implementation kind. v1 ships with `Manual` only — the",
        "other variants are tag-stable placeholders."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Manual"
          },
          {
            "name": "ZkTLS"
          },
          {
            "name": "Other",
            "fields": ["u8"]
          }
        ]
      }
    },
    {
      "name": "AdjudicatorRegistered",
      "docs": [
        "Emitted by `register_adjudicator` when a new per-market `Adjudicator`",
        "PDA is created."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "adjudicator",
            "type": "pubkey"
          },
          {
            "name": "authority",
            "type": "pubkey"
          },
          {
            "name": "kind",
            "docs": [
              "Encoded `AdjudicatorKind` discriminant — 0 = Manual, 1 = ZkTLS,",
              "2 = Other(_)."
            ],
            "type": "u8"
          },
          {
            "name": "ts",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "DisputeRaised",
      "docs": [
        "Emitted by `dispute` when the `dispute_authority` overrides an",
        "attested outcome. Mirrors EVM `AdjudicatorBase.MarketDisputed`."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "adjudicator",
            "type": "pubkey"
          },
          {
            "name": "disputer",
            "type": "pubkey"
          },
          {
            "name": "previous_outcome",
            "docs": ["Outcome recorded by the original `attest_outcome`."],
            "type": "u8"
          },
          {
            "name": "new_outcome",
            "docs": [
              "Outcome the `dispute_authority` is asserting. 0=NO, 1=YES,",
              "2=INVALID per protocol-wide OUTCOME encoding."
            ],
            "type": "u8"
          },
          {
            "name": "ts",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "Market",
      "docs": [
        "Mirror of `sooth_market::Market` — referenced here for the",
        "`market.market_id` PDA seed lookup. The full type is owned by",
        "`sooth_market::state::market`; this entry exists so the IDL is",
        "self-contained for ix decoding."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market_id",
            "type": {
              "array": ["u8", 16]
            }
          },
          {
            "name": "creator",
            "type": "pubkey"
          },
          {
            "name": "adjudicator",
            "type": "pubkey"
          },
          {
            "name": "question_hash",
            "type": {
              "array": ["u8", 32]
            }
          },
          {
            "name": "yes_mint",
            "type": "pubkey"
          },
          {
            "name": "no_mint",
            "type": "pubkey"
          },
          {
            "name": "vault",
            "type": "pubkey"
          },
          {
            "name": "lock_vault",
            "type": "pubkey"
          },
          {
            "name": "start_time",
            "type": "i64"
          },
          {
            "name": "deadline",
            "type": "i64"
          },
          {
            "name": "lifecycle",
            "type": {
              "defined": {
                "name": "MarketLifecycle"
              }
            }
          },
          {
            "name": "winning_outcome",
            "type": "u8"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "vault_authority_bump",
            "type": "u8"
          },
          {
            "name": "lock_authority_bump",
            "type": "u8"
          },
          {
            "name": "yes_mint_bump",
            "type": "u8"
          },
          {
            "name": "no_mint_bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "MarketLifecycle",
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Initializing"
          },
          {
            "name": "Open"
          },
          {
            "name": "Locked"
          },
          {
            "name": "Settled"
          }
        ]
      }
    },
    {
      "name": "OutcomeAttested",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "adjudicator",
            "type": "pubkey"
          },
          {
            "name": "winning_outcome",
            "docs": ["0=NO, 1=YES, 2=INVALID."],
            "type": "u8"
          },
          {
            "name": "ts",
            "type": "i64"
          }
        ]
      }
    }
  ]
}
