    {
      "name": "Market",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market_id",
            "docs": [
              "Deterministic id derived from `keccak256(question || creator || nonce)`,",
              "truncated to 16 bytes per architecture \u00a72.2. Seed for every per-market",
              "PDA in the protocol \u2014 see module comment."
            ],
            "type": {
              "array": [
                "u8",
                16
              ]
            }
          },
          {
            "name": "creator",
            "type": "pubkey"
          },
          {
            "name": "adjudicator",
            "docs": [
              "Adjudicator program id. The adjudicator-CPI auth check on `lock` /",
              "`settle` will validate the caller's program against this."
            ],
            "type": "pubkey"
          },
          {
            "name": "question_hash",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "yes_mint",
            "type": "pubkey"
          },
          {
            "name": "no_mint",
            "type": "pubkey"
          },
          {
            "name": "vault",
            "docs": [
              "USDC ATA owned by `vault_authority` PDA. All collateral for this market."
            ],
            "type": "pubkey"
          },
          {
            "name": "lock_vault",
            "docs": [
              "USDC ATA owned by `lock_authority` PDA. AMM lock-on-sell escrow."
            ],
            "type": "pubkey"
          },
          {
            "name": "start_time",
            "type": "i64"
          },
          {
            "name": "deadline",
            "type": "i64"
          },
          {
            "name": "lifecycle",
            "type": {
              "defined": {
                "name": "MarketLifecycle"
              }
            }
          },
          {
            "name": "winning_outcome",
            "docs": [
              "Resolved outcome, valid only when `lifecycle == Settled`.",
              "0 = NO, 1 = YES, 2 = INVALID per protocol-wide OUTCOME encoding."
            ],
            "type": "u8"
          },
          {
            "name": "bump",
            "docs": [
              "Bump for the `Market` PDA itself."
            ],
            "type": "u8"
          },
          {
            "name": "vault_authority_bump",
            "docs": [
              "Bump for the `vault_authority` signer PDA."
            ],
            "type": "u8"
          },
          {
            "name": "lock_authority_bump",
            "docs": [
              "Bump for the `lock_authority` signer PDA."
            ],
            "type": "u8"
          },
          {
            "name": "yes_mint_bump",
            "docs": [
              "Bump for `yes_mint` PDA."
            ],
            "type": "u8"
          },
          {
            "name": "no_mint_bump",
            "docs": [
              "Bump for `no_mint` PDA."
            ],
            "type": "u8"
          }
        ]
      }
    },
