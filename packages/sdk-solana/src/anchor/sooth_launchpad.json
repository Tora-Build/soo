            "name": "adjudicator",
            "type": "pubkey"
          },
          {
            "name": "yes_mint",
            "type": "pubkey"
          },
          {
            "name": "no_mint",
            "type": "pubkey"
          },
          {
            "name": "vault",
            "type": "pubkey"
          },
          {
            "name": "initial_b",
            "docs": [
              "Initial LMSR liquidity `b` in WAD. Stored on `AmmState` after ix4."
