.DS_Store

# Per-user agent state (Claude Code skills, hooks, scratch). Not
# shared — different developers run different tooling, and
# project-scoped agent state causes merge churn. Pattern follows
# `.cursor/`, `.aider/`, etc.
.claude/

# Env
.env
.env.local
.env.*.local

# Logs
*.log
