{
  "name": "@sooth/demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Faithful Solana fork of sooth-alpha/apps/demo \u2014 TDD harness for @sooth/sdk-solana",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "dev:localnet": "bash scripts/dev-localnet.sh",
    "dev:surfpool": "bash scripts/dev-surfpool.sh",
    "localnet:up": "bash scripts/localnet-up.sh",
    "localnet:down": "bash scripts/localnet-down.sh",
    "cheats": "bash scripts/surfnet-cheats.sh",
    "seed:prepare": "node scripts/seed-localnet.mjs prepare",
    "seed:init": "node scripts/seed-localnet.mjs init",
    "seed:fixture": "bash scripts/seed-fixture.sh",
    "snapshot:season": "node scripts/snapshot-season.mjs",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "node scripts/run-playwright-e2e.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "build:prod": "VITE_TEST_MODE=false VITE_TEST_KEYPAIR_BYTES= VITE_TEST_AUTHORITY_BYTES= pnpm build"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/web3.js": "^1.98.0",
    "@sooth/sdk-solana": "workspace:*",
    "@tanstack/react-query": "^5.51.11",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.25",
    "i18next": "^26.0.3",
    "lucide-react": "^0.424.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.10.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^15.7.4",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
